# Consumed by `brew bundle --global`.
#
# Additive: nothing is ever removed. `mise run brew-cleanup` lists strays.

# ── Taps ────────────────────────────────────────────────────────────────
tap "heroku/brew"
tap "stripe/stripe-cli"
{{ if eq .profile "work" -}}
tap "dopplerhq/cli"
{{ end -}}

# ── Bootstrap ───────────────────────────────────────────────────────────
# Deliberately not managed by mise — these install everything else.
brew "chezmoi"
brew "mise"
brew "gh"
brew "mas"

# ── Services ────────────────────────────────────────────────────────────
brew "postgresql@17", restart_service: true
brew "redis", restart_service: true
brew "opensearch", restart_service: true
brew "pgvector"

# ── Core CLI ────────────────────────────────────────────────────────────
brew "coreutils"
brew "curl"
brew "wget"
brew "aria2"
brew "tree"
brew "git"
brew "git-lfs"
brew "gnupg"
brew "nmap"
brew "neovim"
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "terminal-notifier"

# ── Languages & build ───────────────────────────────────────────────────
# Toolchain and native-extension deps only; runtime versions belong to mise.
brew "cmake"
brew "rust"
brew "libyaml"
brew "libffi"
brew "guile"
brew "protobuf"
brew "biome"
brew "rubyfmt"
brew "yarn"

# ── Media & docs ────────────────────────────────────────────────────────
brew "imagemagick"
brew "vips"
brew "ffmpeg"
brew "exiftool"
brew "ghostscript"
brew "graphviz"
brew "yt-dlp"

# ── Service CLIs ────────────────────────────────────────────────────────
brew "stripe/stripe-cli/stripe"
brew "heroku"
brew "flyctl"
brew "mysql-client"

{{ if eq .profile "work" -}}
# Ships as a cask, not a formula.
cask "dopplerhq/cli/doppler"

{{ end -}}

{{ if eq .profile "personal" -}}
# ── Hardware / IoT ──────────────────────────────────────────────────────
brew "esphome"
brew "esptool"

{{ end -}}
# ── Applications ────────────────────────────────────────────────────────
cask "ghostty"
cask "zed"
cask "arc"
cask "firefox"
cask "google-chrome"
cask "orbstack"
cask "github"
cask "postico"
cask "obsidian"
cask "home-assistant"
cask "claude"
cask "chatgpt"
cask "cleanshot"
cask "maccy"
cask "rectangle"
cask "betterdisplay"
cask "vivid-app"
cask "languagetool-desktop"
cask "handbrake-app"
cask "loom"
cask "beeper"
cask "slack"
cask "soulver"
cask "font-fira-code-nerd-font"
cask "font-cascadia-code-nf"

{{ if eq .profile "personal" -}}
cask "screen-studio"
cask "balenaetcher"
cask "discord"
cask "vlc"
cask "minecraft"

{{ end -}}
