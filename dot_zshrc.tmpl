export EDITOR="zed --wait"
export DISABLE_SPRING="true"
setopt HIST_IGNORE_SPACE

eval "$(/opt/homebrew/bin/brew shellenv)"

eval "$(mise activate zsh)"

# Rebuild the completion dump at most once a day; -C skips the security audit
# and reuses the cache, which is most of compinit's cost.
autoload -Uz compinit
if [[ -n ${HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
eval "$(starship init zsh)"

export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

alias rake="noglob rake"
{{ if eq .profile "work" -}}
alias dr="doppler run --"
{{ end }}
# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# conda's own init costs ~320ms per shell, so it is deferred until first use.
# Base is not auto-activated either way; `conda activate` still shadows the
# mise-managed python inside an environment.
conda() {
    unfunction conda
    __conda_setup="$('/opt/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "/opt/anaconda3/etc/profile.d/conda.sh" ]; then
            . "/opt/anaconda3/etc/profile.d/conda.sh"
        else
            export PATH="/opt/anaconda3/bin:$PATH"
        fi
    fi
    unset __conda_setup
    conda "$@"
}

# Must be sourced last to wrap the widgets above it.
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
