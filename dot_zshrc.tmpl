export EDITOR="zed --wait"
export DISABLE_SPRING="true"
setopt HIST_IGNORE_SPACE

eval "$(/opt/homebrew/bin/brew shellenv)"

eval "$(mise activate zsh)"

# Rebuild the completion dump at most once a day; -C skips the security audit
# and reuses the cache, which is most of compinit's cost. The match has to go
# through an array — [[ ]] does no filename generation, so testing the glob
# directly is always true.
setopt EXTENDED_GLOB
autoload -Uz compinit
zcompdump_stale=(${HOME}/.zcompdump(#qN.mh+24))
if (( $#zcompdump_stale )); then
  compinit
else
  compinit -C
fi
unset zcompdump_stale

source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
eval "$(starship init zsh)"

export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

alias rake="noglob rake"
{{ if eq .profile "work" -}}
alias dr="doppler run --"
{{ end }}
# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# Machine-local config and secrets, kept out of this repository.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# Must be sourced last to wrap the widgets above it.
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
