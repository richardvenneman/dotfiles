#!/usr/bin/env bash
set -uo pipefail

# Changing this hash is what re-triggers the script.
# Brewfile hash: {{ include "dot_Brewfile.tmpl" | sha256sum }}

eval "$(/opt/homebrew/bin/brew shellenv)"

# Homebrew refuses to load anything from a third-party tap until it is trusted.
echo "==> Trusting third-party taps"
brew trust --tap stripe/stripe-cli heroku/brew{{ if eq .profile "work" }} dopplerhq/cli{{ end }} 2>/dev/null || true

# Must precede the bundle: an app already sitting in /Applications makes
# `brew bundle` fail on that cask, which would skip this step entirely.
# Adoption needs sudo when the app's permissions require a chmod.
echo "==> Adopting apps installed outside Homebrew"
for app in arc claude cleanshot postico home-assistant slack soulver beeper{{ if eq .profile "personal" }} screen-studio{{ end }}; do
    if ! brew list --cask "$app" >/dev/null 2>&1; then
        brew install --cask --adopt "$app" || echo "  ! could not adopt $app (skipping)"
    fi
done

# Not fatal: one unavailable package, or not being signed in to the App Store,
# must not stop the runtime and macOS steps that run after this script.
echo "==> brew bundle"
if ! brew bundle install --global --no-upgrade; then
    echo "!! brew bundle did not complete."
    echo "!! Sign in to the App Store, then re-run: brew bundle install --global"
fi
